---
import { ArrowLeft, BookOpen, Cherry } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Không tìm thấy trang | Quỳnh Sensei" description="Trang bạn tìm không tồn tại."><main id="main-content" class="grid min-h-screen place-items-center bg-[radial-gradient(circle_at_50%_20%,#ffe1e5,transparent_35%),#fffaf7] px-4 text-center"><div class="max-w-lg"><div class="mx-auto grid h-28 w-28 place-items-center rounded-full bg-white text-sakura-600 shadow-xl"><BookOpen size={48} aria-hidden="true" /></div><p class="mt-8 flex items-center justify-center gap-2 text-sm font-extrabold uppercase tracking-widest text-sakura-700"><Cherry size={17} aria-hidden="true" />Lạc đường một chút</p><h1 class="mt-3 text-4xl font-extrabold tracking-tight md:text-5xl">Trang bạn tìm không tồn tại.</h1><p class="mt-4 leading-7 text-[#6d6467]">Có thể liên kết đã được thay đổi. Mình đưa bạn trở lại góc học tiếng Nhật nhé.</p><a href="/" class="mt-7 inline-flex min-h-12 items-center gap-2 rounded-full bg-sakura-700 px-6 font-bold text-white"><ArrowLeft size={18} aria-hidden="true" />Quay về trang chủ</a></div></main></BaseLayout>
