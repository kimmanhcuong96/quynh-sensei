---
import { X, ExternalLink } from '@lucide/astro';
---
<dialog id="material-modal" class="m-auto max-h-[90dvh] w-[min(92vw,48rem)] overflow-auto rounded-[1.5rem] border-0 bg-white p-0 text-ink shadow-2xl backdrop:bg-[#271d21]/60 backdrop:backdrop-blur-sm" aria-labelledby="modal-title">
  <div class="sticky top-0 z-10 flex items-center justify-end bg-white/95 p-3 backdrop-blur"><button id="modal-close" class="grid h-11 w-11 place-items-center rounded-full bg-sakura-50 text-sakura-700" aria-label="Đóng chi tiết tài liệu"><X aria-hidden="true" /></button></div>
  <div class="grid gap-6 px-6 pb-7 md:grid-cols-[.8fr_1.2fr] md:px-8"><img id="modal-cover" src="" alt="" width="640" height="400" class="aspect-[16/10] w-full rounded-2xl bg-sakura-50 object-cover" /><div><div class="flex gap-2"><span id="modal-type" class="rounded-full bg-sakura-100 px-3 py-1 text-xs font-extrabold text-sakura-700"></span><span id="modal-level" class="rounded-full bg-[#f3eeee] px-3 py-1 text-xs font-extrabold"></span></div><h2 id="modal-title" class="mt-4 text-2xl font-extrabold leading-tight"></h2><p id="modal-description" class="mt-3 text-sm leading-7 text-[#665d60]"></p><div class="mt-5 grid grid-cols-2 gap-3 rounded-2xl bg-sakura-50 p-4 text-sm"><div><span class="block text-xs text-[#766d70]">Định dạng</span><strong id="modal-format"></strong></div><div><span class="block text-xs text-[#766d70]">Số trang</span><strong id="modal-pages"></strong></div></div><h3 class="mt-5 font-extrabold">Phù hợp với</h3><p id="modal-audience" class="mt-1 text-sm leading-6 text-[#665d60]"></p><h3 class="mt-5 font-extrabold">Nội dung tài liệu</h3><ul id="modal-contents" class="mt-2 list-inside list-disc space-y-1 text-sm text-[#665d60]"></ul><p id="modal-price" class="mt-5 text-xl font-extrabold text-sakura-700"></p><div class="mt-4 flex flex-wrap gap-2"><button id="modal-preview" class="min-h-11 rounded-xl border border-sakura-200 px-4 text-sm font-bold text-sakura-700">Xem thử</button><button id="modal-action" class="min-h-11 rounded-xl bg-sakura-700 px-4 text-sm font-bold text-white"><span class="inline-flex items-center gap-1.5">Mở liên kết <ExternalLink size={15} aria-hidden="true" /></span></button></div></div></div>
</dialog>
