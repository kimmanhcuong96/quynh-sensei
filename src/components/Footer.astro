---
import { Cherry } from '@lucide/astro';
import { profile } from '../data/profile';
---
<footer class="bg-[#251d20] py-10 text-[#ddd2d5]">
  <div class="container-page flex flex-col gap-7 md:flex-row md:items-end md:justify-between"><div><p class="flex items-center gap-2 text-lg font-extrabold text-white"><Cherry size={20} class="text-sakura-500" aria-hidden="true" />{profile.displayName}</p><p class="mt-2 text-sm">Website chia sẻ kiến thức và tài liệu học tiếng Nhật.</p><p class="mt-4 text-xs">© {new Date().getFullYear()} {profile.fullName}. All rights reserved.</p></div><nav aria-label="Điều hướng cuối trang" class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold"><a href="#about" class="hover:text-white">Giới thiệu</a><a href="#materials" class="hover:text-white">Tài liệu</a><button type="button" data-social-link data-web-url={profile.social.zalo.webUrl} data-app-ios={profile.social.zalo.appUrlIOS} data-app-android={profile.social.zalo.appUrlAndroid} class="hover:text-white">Zalo</button><button type="button" data-social-link data-web-url={profile.social.facebook.webUrl} data-app-ios={profile.social.facebook.appUrlIOS} data-app-android={profile.social.facebook.appUrlAndroid} class="hover:text-white">Facebook</button></nav></div>
</footer>
<script>
  import { initSocialLinks } from '../scripts/social-links'; initSocialLinks();
</script>
